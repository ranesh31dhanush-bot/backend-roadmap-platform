# ==========================================
# Top 1% Backend Roadmap Platform Environment
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/backend_roadmap_dev
MONGODB_POOL_SIZE=20

# Authentication & Sessions
JWT_ACCESS_SECRET=dev_jwt_access_secret_min_32_characters_long_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_long_12345
COOKIE_SECRET=dev_cookie_signing_secret_min_32_characters_long_12345
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# OAuth (Google)
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Logging
LOG_LEVEL=info
